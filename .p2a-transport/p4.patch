+from src.adapters import ADAPTER_REGISTRY, browser_required
+from src.adapters.ashby import AshbyAdapter
+from src.adapters.greenhouse import GreenhouseAdapter
+from src.adapters.public_board import (
+    PublicBoardError, description, format_pay, listing_rows, pay_range,
+    public_https_url, timestamp, validate_public_board_config,
+)
+from src.config import Config, load_config, validate_config
+from src.eligibility import classify_eligibility
+from src.filtering import apply_filter_pipeline
+from src.http import HTTPClient
+from src.notifier import build_job_embed
+
+FIXTURES = Path(__file__).parent / 'fixtures'
+GH_URL = 'https://boards-api.greenhouse.io/v1/boards/example/jobs'
+AS_URL = 'https://api.ashbyhq.com/posting-api/job-board/example'
+GH_CONFIG = {'board_token': 'example', 'board_url': 'https://job-boards.greenhouse.io/example',
+             'employer_careers_url': 'https://example.com/careers'}
+AS_CONFIG = {'board_name': 'example', 'board_url': 'https://jobs.ashbyhq.com/example',
+             'employer_careers_url': 'https://example.com/careers'}
+
+
+def payload(platform):
+    return json.loads((FIXTURES / f'{platform}_public_synthetic.json').read_text())
+
+
+def adapter(platform, **config):
+    cls, cfg = (GreenhouseAdapter, GH_CONFIG) if platform == 'greenhouse' else (AshbyAdapter, AS_CONFIG)
+    return cls('Example', dict(cfg, **config), HTTPClient('jobbie-test/1', max_retries=1))
+
+
+def first_job(platform, data=None, **config):
+    endpoint = GH_URL if platform == 'greenhouse' else AS_URL
+    responses.add(responses.GET, endpoint, json=data or payload(platform), status=200)
+    return list(adapter(platform, **config).fetch())[0]
+
+
+@responses.activate
+def test_greenhouse_full_description_post_identity_prospect_and_unknown_date():
+    job = first_job('greenhouse')
+    assert job.id == 'Example::greenhouse::example:101'
+    assert job.source_job_id == '101' and job.source_internal_job_id == '9001'
+    assert job.source_platform == 'greenhouse' and job.source_board == 'example'
+    assert job.source_url == GH_URL + '/101'
+    assert job.description_complete and '0-2 years' in job.raw_text
+    assert '<p>' not in job.raw_text
+    assert job.posted_at is None  # updated_at is NOT first posted_at
+    assert job.source_updated_at == datetime(2026, 11, 6, 9, tzinfo=timezone.utc)
+    assert job.employment_type == 'full_time'
+    assert job.salary is None
+    assert not job.network_priority and job.cohort == 'discovered' and job.referral_status == 'unavailable'
+    assert parse_qs(urlsplit(responses.calls[0].request.url).query) == {'content': ['true']}
+    assert responses.calls[0].request.method == 'GET'
+
+
