+def _temp_run_config(tmp_path, companies):
+    from src.storage import _empty_state
+    state=tmp_path/'history.json'
+    seed=_empty_state()
+    seed['first_run_completed_at']='2026-11-01T00:00:00+00:00'
+    state.write_text(json.dumps(seed,sort_keys=True))
+    config=tmp_path/'companies.yaml'
+    config.write_text(yaml.safe_dump({'defaults':{'state_path':str(state),'request_delay_seconds':[0,0]},
+                                    'filters':{'mode':'new_grad_full_time','freshness_hours':999999},
+                                    'companies':companies}))
+    return config,state
