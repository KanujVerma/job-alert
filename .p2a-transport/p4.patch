+def test_new_adapters_do_run_dry_run_preserves_state_and_never_posts(tmp_path,monkeypatch):
+    from main import do_run
+    companies=[{'name':'GH test','adapter':'greenhouse','enabled':True,'config':GH_CONFIG},
+               {'name':'AS test','adapter':'ashby','enabled':True,'config':AS_CONFIG}]
+    config,state=_temp_run_config(tmp_path,companies); before=state.read_bytes()
+    responses.add(responses.GET,GH_URL,json=payload('greenhouse'))
+    responses.add(responses.GET,AS_URL,json=payload('ashby'))
+    monkeypatch.setenv('DISCORD_WEBHOOK_URL','https://discord.com/api/webhooks/forbidden-test')
+    monkeypatch.setattr(HTTPClient,'polite_delay',lambda *_: None)
+    args=SimpleNamespace(config=str(config),dry_run=True,verbose=True,company=None,
+                         firehose_first_run=False,summary_first_run=False,rerun_backfill=False)
+    with patch('src.notifier.Notifier.send_job_alert') as send, patch('src.notifier.Notifier.send_summary') as summary:
+        assert do_run(args)==0
+        send.assert_not_called();summary.assert_not_called()
+    assert state.read_bytes()==before
+    assert {c.request.method for c in responses.calls}=={'GET'}
+    assert len(responses.calls)==2
